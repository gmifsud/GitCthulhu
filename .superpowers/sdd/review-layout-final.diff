+//! Left-rail Explorer accordion: LOCAL / REMOTE / WORKTREES / STASHES / TAGS.
+//!
+//! Each section has a clickable header that collapses its body. The collapsed state
+//! lives on `WorktreeSession::explorer_collapsed` (pure, reducer-safe).
+
+use crate::app::{GitApp, Message};
+use crate::context_menu::ContextTarget;
+use crate::session::{basename, same_path, ExplorerSection};
+use crate::theme::DesignTokens;
+use core_domain::{Branch, Stash, Tag, Worktree};
+use iced::widget::button::Status;
+use iced::widget::scrollable::{Direction, Scrollbar};
+use iced::widget::text::Wrapping;
+use iced::widget::{button, column, container, mouse_area, row, scrollable, text};
+use iced::{Alignment, Background, Border, Color, Element, Length, Shadow};
+
+use super::chrome::{
+    glyph, hairline, icon_button, symbol_reading, Reading, BRANCH_MARK, FOLD_CLOSED, FOLD_OPEN,
+    REMOTE_MARK, STASH_MARK, TAG_MARK,
+};
+
+const HEAD_PADDING_Y: f32 = 4.0;
+const HEAD_PADDING_X: f32 = 8.0;
+const OPEN_MARK: &str = "ΓùÅ";
+const DETACHED: &str = "(detached)";
+
+/// The full Explorer accordion pane for the left files rail.
+pub(super) fn explorer_pane<'a>(
+    app: &'a GitApp,
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let session = app.session();
+    let collapsed = &session.explorer_collapsed;
+
+    let branches = &session.state.branches;
+    let stashes = &session.state.stashes;
+    let tags = &session.state.tags;
+
+    let locals: Vec<&Branch> = branches.iter().filter(|b| !b.is_remote).collect();
+    let remotes: Vec<&Branch> = branches.iter().filter(|b| b.is_remote).collect();
+    let worktrees = &app.worktree_catalogue;
+
+    column![
+        section_block(
+            "LOCAL",
+            locals.len(),
+            ExplorerSection::Local,
+            collapsed.local,
+            (!collapsed.local).then(|| local_rows(&locals, tokens, reading)),
+            tokens,
+            reading,
+        ),
+        hairline(tokens),
+        section_block(
+            "REMOTE",
+            remotes.len(),
+            ExplorerSection::Remote,
+            collapsed.remote,
+            (!collapsed.remote).then(|| remote_rows(&remotes, tokens, reading)),
+            tokens,
+            reading,
+        ),
+        hairline(tokens),
+        section_block(
+            "WORKTREES",
+            worktrees.len(),
+            ExplorerSection::Worktrees,
+            collapsed.worktrees,
+            (!collapsed.worktrees).then(|| worktrees_rows(app, worktrees, tokens, reading)),
+            tokens,
+            reading,
+        ),
+        hairline(tokens),
+        section_block(
+            "STASHES",
+            stashes.len(),
+            ExplorerSection::Stashes,
+            collapsed.stashes,
+            (!collapsed.stashes).then(|| stash_rows(stashes, tokens, reading)),
+            tokens,
+            reading,
+        ),
+        hairline(tokens),
+        section_block(
+            "TAGS",
+            tags.len(),
+            ExplorerSection::Tags,
+            collapsed.tags,
+            (!collapsed.tags).then(|| tag_rows(tags, tokens, reading)),
+            tokens,
+            reading,
+        ),
+    ]
+    .width(Length::Fill)
+    .height(Length::Fill)
+    .into()
+}
+
+/// One collapsible accordion block: header + optional body (body omitted when collapsed).
+fn section_block<'a>(
+    title: &'static str,
+    count: usize,
+    section: ExplorerSection,
+    collapsed: bool,
+    body: Option<Element<'a, Message>>,
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let chevron = if collapsed { FOLD_CLOSED } else { FOLD_OPEN };
+    let header_label = format!("{title} ┬╖ {count}");
+    let sym = symbol_reading(&reading);
+    let header = button(
+        row![
+            text(chevron).font(sym.font).size(reading.size),
+            text(header_label)
+                .font(reading.font)
+                .size((reading.size - 1.0).max(11.0))
+                .style(move |_| iced::widget::text::Style {
+                    color: Some(tokens.text_muted),
+                }),
+        ]
+        .spacing(4)
+        .align_y(Alignment::Center),
+    )
+    .padding([HEAD_PADDING_Y, HEAD_PADDING_X])
+    .width(Length::Fill)
+    .on_press(Message::ToggleExplorerSection(section))
+    .style(move |_theme, status| {
+        let hot = matches!(status, Status::Hovered | Status::Pressed);
+        iced::widget::button::Style {
+            background: Some(Background::Color(if hot {
+                tokens.border
+            } else {
+                Color::TRANSPARENT
+            })),
+            text_color: tokens.text_muted,
+            border: Border::default(),
+            shadow: Shadow::default(),
+        }
+    });
+
+    let mut block = column![header].width(Length::Fill);
+    if let Some(body) = body {
+        debug_assert!(!collapsed);
+        block = block.push(body);
+    }
+    block.into()
+}
+
+// ΓöÇΓöÇ LOCAL ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+
+fn local_rows<'a>(
+    locals: &[&Branch],
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let mut rows = column![].spacing(2).padding([4, 8]);
+    for branch in locals {
+        let selected = branch.is_head;
+        rows = rows.push(branch_row(
+            BRANCH_MARK,
+            branch.name.clone(),
+            Message::ChooseBranch(branch.name.clone()),
+            selected,
+            branch.is_head,
+            Some(ContextTarget::LocalBranch {
+                name: branch.name.clone(),
+                tip: branch.tip.clone(),
+            }),
+            tokens,
+            reading,
+        ));
+    }
+    if locals.is_empty() {
+        rows = rows.push(empty_hint("No local branches", tokens, reading));
+    }
+    rows.into()
+}
+
+// ΓöÇΓöÇ REMOTE ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+
+fn remote_rows<'a>(
+    remotes: &[&Branch],
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let mut rows = column![].spacing(2).padding([4, 8]);
+    for branch in remotes {
+        let selected = false;
+        rows = rows.push(branch_row(
+            REMOTE_MARK,
+            branch.name.clone(),
+            Message::Select(crate::selection::Selection::Remote {
+                name: branch.name.clone(),
+            }),
+            selected,
+            false,
+            None,
+            tokens,
+            reading,
+        ));
+    }
+    if remotes.is_empty() {
+        rows = rows.push(empty_hint("No remote branches", tokens, reading));
+    }
+    rows.into()
+}
+
+// ΓöÇΓöÇ WORKTREES ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+
+fn worktrees_rows<'a>(
+    app: &'a GitApp,
+    worktrees: &'a [Worktree],
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let mut rows = column![].spacing(2);
+    if worktrees.is_empty() {
+        rows = rows.push(
+            container(empty_hint("No worktrees loaded.", tokens, reading)).padding([4, 8]),
+        );
+    }
+    for entry in worktrees {
+        rows = rows.push(worktree_row(app, entry, tokens, reading));
+    }
+    // Embedded scrollbar so it takes layout space and does not cover buttons.
+    let list = scrollable(rows).direction(Direction::Vertical(
+        Scrollbar::new().width(8).scroller_width(8).spacing(6),
+    ));
+    container(list).max_height(160.0).width(Length::Fill).into()
+}
+
+fn worktree_row<'a>(
+    app: &'a GitApp,
+    entry: &'a Worktree,
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let open = app
+        .sessions
+        .iter()
+        .any(|session| same_path(&session.path, &entry.path));
+    let active = app
+        .sessions
+        .get(app.active)
+        .is_some_and(|session| same_path(&session.path, &entry.path));
+    let branch = if entry.branch.is_empty() {
+        DETACHED.to_string()
+    } else {
+        entry.branch.clone()
+    };
+
+    let mut name_row = row![text(basename(&entry.path).to_string())
+        .font(reading.font)
+        .size(reading.size)
+        .wrapping(Wrapping::None)
+        .style(move |_| iced::widget::text::Style {
+            color: Some(if open {
+                tokens.text_primary
+            } else {
+                tokens.text_secondary
+            }),
+        })]
+    .spacing(6)
+    .align_y(Alignment::Center);
+
+    if entry.is_main {
+        name_row = name_row.push(wt_tag("main", tokens, reading));
+    }
+    if entry.locked {
+        name_row = name_row.push(wt_tag("locked", tokens, reading));
+    }
+
+    let marker: Element<'a, Message> = glyph(
+        OPEN_MARK,
+        (reading.size - 4.0).max(7.0),
+        if open {
+            tokens.accent_primary
+        } else {
+            Color::TRANSPARENT
+        },
+        &reading,
+    );
+
+    let body = button(
+        row![
+            marker,
+            column![
+                name_row,
+                text(branch)
+                    .font(reading.font)
+                    .size((reading.size - 2.0).max(11.0))
+                    .wrapping(Wrapping::None)
+                    .style(move |_| iced::widget::text::Style {
+                        color: Some(tokens.accent_primary),
+                    }),
+            ]
+            .spacing(1)
+            .width(Length::Fill),
+        ]
+        .spacing(8)
+        .align_y(Alignment::Center),
+    )
+    .padding([3, 6])
+    .width(Length::Fill)
+    .on_press(Message::OpenWorktree(entry.path.clone()))
+    .style(move |_theme, status| {
+        let hot = matches!(status, Status::Hovered | Status::Pressed);
+        iced::widget::button::Style {
+            background: Some(Background::Color(if active {
+                tokens.bg_raised
+            } else if hot {
+                tokens.border
+            } else {
+                Color::TRANSPARENT
+            })),
+            text_color: tokens.text_secondary,
+            border: Border {
+                color: if active {
+                    tokens.accent_primary
+                } else {
+                    Color::TRANSPARENT
+                },
+                width: if active { 1.0 } else { 0.0 },
+                radius: 4.0.into(),
+            },
+            shadow: Shadow::default(),
+        }
+    });
+
+    let remove_key = format!("worktree-remove:{}", entry.path);
+    let tip_ready = app.tip_ready(&remove_key);
+    row![
+        body,
+        icon_button(
+            "├ù",
+            "Remove worktree",
+            remove_key,
+            tip_ready,
+            Message::AskRemoveWorktree {
+                path: entry.path.clone(),
+            },
+            !entry.is_main && !app.worktree_busy,
+            false,
+            tokens,
+            reading,
+        ),
+    ]
+    .spacing(4)
+    .align_y(Alignment::Center)
+    .into()
+}
+
+fn wt_tag<'a>(label: &'static str, tokens: DesignTokens, reading: Reading) -> Element<'a, Message> {
+    use iced::widget::Theme;
+    container(
+        text(label)
+            .font(reading.font)
+            .size((reading.size - 3.0).max(10.0))
+            .style(move |_| iced::widget::text::Style {
+                color: Some(tokens.text_muted),
+            }),
+    )
+    .padding([0, 4])
+    .style(move |_theme: &Theme| container::Style {
+        background: Some(Background::Color(Color::TRANSPARENT)),
+        text_color: Some(tokens.text_muted),
+        border: Border {
+            color: tokens.chip_border,
+            width: 1.0,
+            radius: 3.0.into(),
+        },
+        shadow: Shadow::default(),
+    })
+    .into()
+}
+
+// ΓöÇΓöÇ STASHES ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+
+fn stash_rows<'a>(stashes: &'a [Stash], tokens: DesignTokens, reading: Reading) -> Element<'a, Message> {
+    let mut rows = column![].spacing(2).padding([4, 8]);
+    for stash in stashes {
+        let msg = Message::Select(crate::selection::Selection::Stash {
+            index: stash.index,
+            message: stash.message.clone(),
+        });
+        rows = rows.push(branch_row(
+            STASH_MARK,
+            stash.message.clone(),
+            msg,
+            false,
+            false,
+            None,
+            tokens,
+            reading,
+        ));
+    }
+    if stashes.is_empty() {
+        rows = rows.push(empty_hint("No stashes", tokens, reading));
+    }
+    rows.into()
+}
+
+// ΓöÇΓöÇ TAGS ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+
+fn tag_rows<'a>(tags: &'a [Tag], tokens: DesignTokens, reading: Reading) -> Element<'a, Message> {
+    let mut rows = column![].spacing(2).padding([4, 8]);
+    for tag in tags {
+        let msg = Message::Select(crate::selection::Selection::Tag {
+            name: tag.name.clone(),
+            commit_id: tag.commit_id.clone(),
+        });
+        rows = rows.push(branch_row(
+            TAG_MARK,
+            tag.name.clone(),
+            msg,
+            false,
+            false,
+            None,
+            tokens,
+            reading,
+        ));
+    }
+    if tags.is_empty() {
+        rows = rows.push(empty_hint("No tags", tokens, reading));
+    }
+    rows.into()
+}
+
+// ΓöÇΓöÇ Shared helpers ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+
+#[allow(clippy::too_many_arguments)]
+fn branch_row<'a>(
+    mark: &'static str,
+    label: String,
+    message: Message,
+    selected: bool,
+    accent: bool,
+    context: Option<ContextTarget>,
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let mark_color = if accent {
+        tokens.accent_primary
+    } else if selected {
+        tokens.text_primary
+    } else {
+        tokens.text_muted
+    };
+    let label_color = if accent {
+        tokens.accent_primary
+    } else if selected {
+        tokens.text_primary
+    } else {
+        tokens.text_secondary
+    };
+    let row = button(
+        row![
+            glyph(mark, reading.size, mark_color, &reading),
+            text(label)
+                .font(reading.font)
+                .size(reading.size)
+                .wrapping(Wrapping::None)
+                .style(move |_| iced::widget::text::Style {
+                    color: Some(label_color),
+                }),
+        ]
+        .spacing(8)
+        .align_y(Alignment::Center),
+    )
+    .width(Length::Fill)
+    .padding([4, 8])
+    .on_press(message)
+    .style(move |_theme, status| {
+        let hot = matches!(status, Status::Hovered | Status::Pressed);
+        iced::widget::button::Style {
+            background: Some(Background::Color(if selected || hot {
+                tokens.border
+            } else {
+                Color::TRANSPARENT
+            })),
+            text_color: label_color,
+            border: Border {
+                color: Color::TRANSPARENT,
+                width: 0.0,
+                radius: 4.0.into(),
+            },
+            shadow: Shadow::default(),
+        }
+    });
+    if let Some(target) = context {
+        mouse_area(row)
+            .on_right_press(Message::OpenContextMenu { target })
+            .into()
+    } else {
+        row.into()
+    }
+}
+
+fn empty_hint<'a>(label: &'static str, tokens: DesignTokens, reading: Reading) -> Element<'a, Message> {
+    text(label)
+        .font(reading.font)
+        .size(reading.size)
+        .style(move |_| iced::widget::text::Style {
+            color: Some(tokens.text_muted),
+        })
+        .into()
+}
diff --git a/gui_app/src/view/files_nav.rs b/gui_app/src/view/files_nav.rs
new file mode 100644
index 0000000..9087acb
--- /dev/null
+++ b/gui_app/src/view/files_nav.rs
@@ -0,0 +1,317 @@
+//! Right inspector: working-tree staging stacked above commit file list.
+
+use crate::app::{GitApp, Message};
+use crate::changes::change_sections;
+use crate::selection::{short_hash, Selection};
+use crate::theme::DesignTokens;
+use core_domain::RepoStatus;
+use iced::widget::text::Wrapping;
+use iced::widget::{button, column, container, row, scrollable, text};
+use iced::{Alignment, Background, Border, Color, Element, Length, Shadow};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use super::changes::wip_working_tree_block;
+use super::chrome::{command_button, Reading};
+use super::history::relative_age;
+use super::patch::patch_stats;
+use iced::widget::button::Status;
+
+pub(crate) fn show_wip_block(status: Option<&RepoStatus>) -> bool {
+    status.is_some_and(|status| !change_sections(status).is_empty())
+}
+
+pub(crate) fn show_commit_block(selection: &Selection) -> bool {
+    matches!(selection, Selection::Commit { .. })
+}
+
+fn show_tag_block(selection: &Selection) -> bool {
+    matches!(selection, Selection::Tag { .. })
+}
+
+pub(crate) fn files_navigator<'a>(
+    app: &'a GitApp,
+    selection: &Selection,
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let status = app.session().state.current_status.as_ref();
+    let wip = show_wip_block(status);
+    let commit = show_commit_block(selection);
+    let tag = show_tag_block(selection);
+
+    if !wip && !commit && !tag {
+        return empty_navigator_hint(tokens, reading);
+    }
+
+    let mut body = column![].spacing(8).width(Length::Fill);
+
+    if wip {
+        body = body.push(wip_working_tree_block(app, selection, tokens, reading));
+    }
+
+    if commit {
+        if let Some(meta) = commit_meta(app, selection, tokens, reading) {
+            body = body.push(meta);
+        }
+        body = body.push(commit_files_block(app, tokens, reading));
+    } else if tag {
+        if let Some(meta) = tag_meta(selection, tokens, reading) {
+            body = body.push(meta);
+        }
+        body = body.push(commit_files_block(app, tokens, reading));
+    }
+
+    container(scrollable(body))
+        .width(Length::Fill)
+        .height(Length::Fill)
+        .into()
+}
+
+fn empty_navigator_hint<'a>(tokens: DesignTokens, reading: Reading) -> Element<'a, Message> {
+    container(
+        text("Select a commit or make a change.")
+            .font(reading.font)
+            .size(reading.size)
+            .style(move |_| text::Style {
+                color: Some(tokens.text_muted),
+            }),
+    )
+    .padding([12, 12])
+    .width(Length::Fill)
+    .height(Length::Fill)
+    .into()
+}
+
+fn commit_meta<'a>(
+    app: &'a GitApp,
+    selection: &Selection,
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Option<Element<'a, Message>> {
+    let Selection::Commit { id } = selection else {
+        return None;
+    };
+    let commit = app.session().state.commits.iter().find(|commit| &commit.id == id)?;
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs() as i64)
+        .unwrap_or(commit.timestamp);
+    let meta = format!(
+        "{} ┬╖ {} ┬╖ {}",
+        short_hash(&commit.id),
+        commit.author,
+        relative_age(now, commit.timestamp)
+    );
+    Some(
+        container(
+            column![
+                text(commit.message.clone())
+                    .font(reading.font)
+                    .size(reading.size)
+                    .style(move |_| text::Style {
+                        color: Some(tokens.text_primary),
+                    }),
+                text(meta)
+                    .font(reading.font)
+                    .size((reading.size - 2.0).max(11.0))
+                    .style(move |_| text::Style {
+                        color: Some(tokens.text_muted),
+                    }),
+            ]
+            .spacing(4),
+        )
+        .padding([0, 12])
+        .into(),
+    )
+}
+
+fn tag_meta<'a>(
+    selection: &Selection,
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Option<Element<'a, Message>> {
+    let Selection::Tag { name, .. } = selection else {
+        return None;
+    };
+    Some(
+        container(
+            text(name.clone())
+                .font(reading.font)
+                .size(reading.size)
+                .style(move |_| text::Style {
+                    color: Some(tokens.text_primary),
+                }),
+        )
+        .padding([0, 12])
+        .into(),
+    )
+}
+
+pub(crate) fn commit_files_block<'a>(
+    app: &'a GitApp,
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let mut block = column![].spacing(2).padding([4, 12]);
+    if app.session().patch_pending {
+        return block
+            .push(
+                text("Loading filesΓÇª")
+                    .font(reading.font)
+                    .size(reading.size)
+                    .style(move |_| text::Style {
+                        color: Some(tokens.text_muted),
+                    }),
+            )
+            .into();
+    }
+    if let Some(error) = &app.session().patch_error {
+        return block
+            .push(
+                text(error.clone())
+                    .font(reading.font)
+                    .size(reading.size)
+                    .style(move |_| text::Style {
+                        color: Some(tokens.accent_primary),
+                    }),
+            )
+            .into();
+    }
+    if app.session().patches.is_empty() {
+        return block
+            .push(
+                text("No files in this commit")
+                    .font(reading.font)
+                    .size(reading.size)
+                    .style(move |_| text::Style {
+                        color: Some(tokens.text_muted),
+                    }),
+            )
+            .into();
+    }
+
+    let (total_added, total_removed) = app.session().patches.iter().fold((0, 0), |(a, r), patch| {
+        let (added, removed) = patch_stats(patch);
+        (a + added, r + removed)
+    });
+    let title = format!(
+        "Files changed ({})  +{total_added} ΓêÆ{total_removed}",
+        app.session().patches.len()
+    );
+    let mut heading = row![text(title)
+        .font(reading.font)
+        .size((reading.size - 2.0).max(11.0))
+        .style(move |_| text::Style {
+            color: Some(tokens.text_muted),
+        })]
+    .spacing(8)
+    .align_y(Alignment::Center);
+    if app.session().focused_diff_path.is_some() {
+        heading = heading.push(iced::widget::horizontal_space()).push(
+            command_button("All files", Message::ClearDiffFocus, true, tokens, reading),
+        );
+    }
+    block = block.push(heading);
+
+    for patch in &app.session().patches {
+        let (added, removed) = patch_stats(patch);
+        let focused = app.session().focused_diff_path.as_deref() == Some(patch.path.as_str());
+        let stats = if patch.binary {
+            "binary".to_string()
+        } else {
+            format!("+{added} ΓêÆ{removed}")
+        };
+        let path = patch.path.clone();
+        block = block.push(
+            button(
+                row![
+                    text(patch.path.clone())
+                        .font(reading.mono)
+                        .size((reading.size - 2.0).max(11.0))
+                        .wrapping(Wrapping::None)
+                        .width(Length::Fill),
+                    text(stats)
+                        .font(reading.mono)
+                        .size((reading.size - 2.0).max(11.0))
+                        .style(move |_| text::Style {
+                            color: Some(if added > 0 && removed == 0 {
+                                tokens.added
+                            } else if removed > 0 && added == 0 {
+                                tokens.removed
+                            } else {
+                                tokens.text_muted
+                            }),
+                        }),
+                ]
+                .spacing(8)
+                .align_y(Alignment::Center),
+            )
+            .padding([2, 4])
+            .width(Length::Fill)
+            .on_press(Message::FocusDiffPath(path))
+            .style(move |_theme, status| {
+                let hot = matches!(status, Status::Hovered | Status::Pressed);
+                iced::widget::button::Style {
+                    background: Some(Background::Color(if focused || hot {
+                        tokens.border
+                    } else {
+                        Color::TRANSPARENT
+                    })),
+                    text_color: tokens.text_secondary,
+                    border: Border::default(),
+                    shadow: Shadow::default(),
+                }
+            }),
+        );
+    }
+
+    block.into()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use core_domain::RepoStatus;
+
+    fn clean_status() -> RepoStatus {
+        RepoStatus {
+            staged_files: vec![],
+            unstaged_files: vec![],
+            untracked_files: vec![],
+            tracking: None,
+            head_commit_id: None,
+        }
+    }
+
+    fn dirty_status() -> RepoStatus {
+        RepoStatus {
+            staged_files: vec![],
+            unstaged_files: vec!["a.rs".into()],
+            untracked_files: vec![],
+            tracking: None,
+            head_commit_id: None,
+        }
+    }
+
+    #[test]
+    fn wip_block_hidden_when_clean() {
+        assert!(!show_wip_block(None));
+        assert!(!show_wip_block(Some(&clean_status())));
+    }
+
+    #[test]
+    fn wip_block_shown_when_dirty() {
+        assert!(show_wip_block(Some(&dirty_status())));
+    }
+
+    #[test]
+    fn commit_block_for_commit_selection_only() {
+        assert!(show_commit_block(&Selection::Commit {
+            id: "abc".into()
+        }));
+        assert!(!show_commit_block(&Selection::Branch {
+            name: "main".into(),
+            current: true,
+        }));
+    }
+}
