+fn hunk_button<'a>(
+    mode: crate::layout::HunkMode,
+    current: crate::layout::HunkMode,
+    tokens: DesignTokens,
+) -> Element<'a, Message> {
+    let active = mode == current;
+    let ink = if active {
+        Color::BLACK
+    } else {
+        tokens.text_primary
+    };
+    let label = match mode {
+        crate::layout::HunkMode::Beside => "B",
+        crate::layout::HunkMode::Wide => "W",
+        crate::layout::HunkMode::Focus => "F",
+    };
+    iced::widget::button(
+        text(label)
+            .size(11.0)
+            .style(move |_| text::Style { color: Some(ink) }),
+    )
+    .padding([4, 6])
+    .on_press(Message::SetHunkMode(mode))
+    .style(move |_theme, status| {
+        let hot = matches!(
+            status,
+            iced::widget::button::Status::Hovered | iced::widget::button::Status::Pressed
+        );
+        iced::widget::button::Style {
+            background: Some(Background::Color(if active {
+                tokens.accent_primary
+            } else if hot {
+                tokens.bg_raised
+            } else {
+                tokens.chip
+            })),
+            text_color: ink,
+            border: Border {
+                color: if active {
+                    tokens.accent_primary
+                } else {
+                    tokens.chip_border
+                },
+                width: 1.0,
+                radius: 0.0.into(),
+            },
+            shadow: Shadow::default(),
+        }
+    })
+    .into()
+}
