+
+    #[test]
+    fn a_pending_checkout_belongs_to_the_session_that_started_it() {
+        let mut app = two_session_app();
+        app.sessions[1].pending_checkout = Some("topic".to_string());
+        app.sessions[1].state.loading = true;
