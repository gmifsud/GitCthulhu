+        ));
+    }
+    if tags.is_empty() {
+        rows = rows.push(empty_hint("No tags", tokens, reading));
+    }
+    rows.into()
+}
+
+// ΓöÇΓöÇ Shared helpers ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+
+#[allow(clippy::too_many_arguments)]
+fn branch_row<'a>(
+    mark: &'static str,
+    label: String,
+    message: Message,
+    selected: bool,
+    accent: bool,
+    context: Option<ContextTarget>,
+    tokens: DesignTokens,
+    reading: Reading,
+) -> Element<'a, Message> {
+    let mark_color = if accent {
+        tokens.accent_primary
+    } else if selected {
+        tokens.text_primary
+    } else {
+        tokens.text_muted
+    };
+    let label_color = if accent {
+        tokens.accent_primary
+    } else if selected {
+        tokens.text_primary
+    } else {
+        tokens.text_secondary
+    };
+    let row = button(
+        row![
+            glyph(mark, reading.size, mark_color, &reading),
+            text(label)
+                .font(reading.font)
+                .size(reading.size)
+                .wrapping(Wrapping::None)
+                .style(move |_| iced::widget::text::Style {
+                    color: Some(label_color),
+                }),
+        ]
+        .spacing(8)
+        .align_y(Alignment::Center),
+    )
+    .width(Length::Fill)
+    .padding([4, 8])
+    .on_press(message)
+    .style(move |_theme, status| {
+        let hot = matches!(status, Status::Hovered | Status::Pressed);
+        iced::widget::button::Style {
+            background: Some(Background::Color(if selected || hot {
+                tokens.border
+            } else {
+                Color::TRANSPARENT
+            })),
+            text_color: label_color,
+            border: Border {
+                color: Color::TRANSPARENT,
+                width: 0.0,
+                radius: 4.0.into(),
+            },
+            shadow: Shadow::default(),
+        }
+    });
+    if let Some(target) = context {
+        mouse_area(row)
+            .on_right_press(Message::OpenContextMenu { target })
+            .into()
+    } else {
+        row.into()
+    }
+}
+
+fn empty_hint<'a>(label: &'static str, tokens: DesignTokens, reading: Reading) -> Element<'a, Message> {
+    text(label)
+        .font(reading.font)
+        .size(reading.size)
+        .style(move |_| iced::widget::text::Style {
+            color: Some(tokens.text_muted),
+        })
+        .into()
+}
